    .vf-bond-inputs,
    .vf-bond-results,
    .vf-bond-table {
      grid-template-columns: 1fr;
    }
    .vf-calc-result {
      grid-template-columns: 1fr;
    }
    .vf-calc-result > div:last-child {
      grid-column: auto;
    }
    .vf-flip-card,
    .vf-flip-inner {
      min-height: 330px;
    }
    .vf-practice-card,
    .vf-practice-card .vf-flip-inner {
      min-height: 20rem;
    }
    .vf-flip-face {
      padding: 1.25rem;
    }
    .vf-flip-face {
      padding: 1.1rem;
    }
    .vf-flip-face strong {
      font-size: 1.45rem;
    }
    .vf-dialog {
      width: calc(100% - 1.5rem);
      padding: 1.3rem;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    :global(html) {
      scroll-behavior: auto;
    }
    .vf-button,
    .vf-flip-card,
    .vf-flip-inner {
      transition: none;
    }
    .vf-flip-card:hover,
    .vf-flip-card:focus-within {
      transform: none;
    }
    .vf-flip-card:hover .vf-card-icon,
    .vf-flip-card:focus-within .vf-card-icon {
      transform: none;
    }
    .vf-flip-card.is-active .vf-card-icon {
      animation: none;
    }
    .vf-flip-card:hover .vf-flip-inner,
    .vf-flip-card:focus-within .vf-flip-inner {
      transform: none;
    }
    .vf-pinup-seal,
    .vf-pinup-seal::before,
    .vf-pinup-seal::after {
      animation: none;
    }
  }
</style>

<script>
  const money = (value: number) => {
    const crore = value / 10000000;
    const lakh = value / 100000;
    if (crore >= 1) return `₹ ${crore.toFixed(crore >= 10 ? 1 : 2)} Cr`;
    if (lakh >= 1) return `₹ ${lakh.toFixed(lakh >= 10 ? 1 : 2)} Lakh`;
    return `₹ ${Math.round(value).toLocaleString('en-IN')}`;
  };
  const moneyFull = (value: number) => `₹ ${Math.round(value).toLocaleString('en-IN')}`;
  const investment = document.querySelector<HTMLInputElement>('#investment');
  const investmentLabel = document.querySelector<HTMLElement>('#investment-label');
  const sipOnly = document.querySelector<HTMLElement>('[data-sip-only]');
  const sipTools = document.querySelectorAll<HTMLElement>('[data-sip-tool]');
  const bondPanel = document.querySelector<HTMLElement>('[data-bond-panel]');
  const bondAmount = document.querySelector<HTMLInputElement>('#bond-amount');
  const bondTenure = document.querySelector<HTMLInputElement>('#bond-tenure');
  const fdRate = document.querySelector<HTMLInputElement>('#fd-rate');
  const bondRate = document.querySelector<HTMLInputElement>('#bond-rate');
  const bondTax = document.querySelector<HTMLSelectElement>('#bond-tax');
  const years = document.querySelector<HTMLInputElement>('#years');
  const rate = document.querySelector<HTMLInputElement>('#rate');
  const stepup = document.querySelector<HTMLInputElement>('#stepup');
  const goal = document.querySelector<HTMLInputElement>('#goal');
  const stepupValue = document.querySelector<HTMLOutputElement>('#stepup-value');
  const goalValue = document.querySelector<HTMLOutputElement>('#goal-value');
  const inflationValue = document.querySelector<HTMLOutputElement>('#inflation-value');
  const goalGap = document.querySelector<HTMLOutputElement>('#goal-gap');
  const investmentValue = document.querySelector<HTMLOutputElement>('#investment-value');
  const yearsValue = document.querySelector<HTMLOutputElement>('#years-value');
  const rateValue = document.querySelector<HTMLOutputElement>('#rate-value');
  const futureValue = document.querySelector<HTMLOutputElement>('#future-value');
  const principalValue = document.querySelector<HTMLOutputElement>('#principal-value');
  const growthValue = document.querySelector<HTMLOutputElement>('#growth-value');
  let calculatorMode: 'sip' | 'lumpsum' | 'bond' = 'sip';
  const updateBondCalculator = () => {
    if (!bondAmount || !bondTenure || !fdRate || !bondRate || !bondTax) return;
    const principal = Number(bondAmount.value);
    const years = Number(bondTenure.value);
    const tax = Number(bondTax.value);
    const fdMaturity = principal * (1 + Number(fdRate.value) / 100) ** years;
    const bondMaturity = principal * (1 + Number(bondRate.value) / 100) ** years;
    const fdInterest = (fdMaturity - principal) * (1 - tax);
    const bondInterest = (bondMaturity - principal) * (1 - tax);
    const setText = (id: string, value: string) => {
      const element = document.querySelector<HTMLElement>(id);
      if (element) element.textContent = value;
    };
    setText('#bond-amount-value', moneyFull(principal));
    setText('#bond-tenure-value', `${years} years`);
    setText('#fd-rate-value', `${Number(fdRate.value).toFixed(1)}%`);
    setText('#bond-rate-value', `${Number(bondRate.value).toFixed(1)}%`);
    setText('#fd-maturity', money(fdMaturity));
    setText('#bond-maturity', money(bondMaturity));
    setText('#bond-extra', `+ ${money(Math.max(0, bondInterest - fdInterest))}`);
    setText('#bond-principal', money(principal));
    setText('#fd-interest', money(fdInterest));
    setText('#bond-interest', money(bondInterest));
  };
  const updateCalculator = () => {
    if (
      !investment ||
      !investmentLabel ||
      !years ||
      !rate ||
      !investmentValue ||
      !yearsValue ||
      !rateValue ||
      !futureValue ||
      !principalValue ||
      !growthValue ||
      !stepup ||
      !goal ||
      !stepupValue ||
      !goalValue ||
      !inflationValue ||
      !goalGap
    )
      return;
    const monthly = Number(investment.value);
    const horizon = Number(years.value);
    const annualRate = Number(rate.value);
    const annualStepup = Number(stepup.value) / 100;
    const goalAmount = Number(goal.value);
    const monthlyRate = annualRate / 100 / 12;
    const months = horizon * 12;
    let future = 0;
    let principal = 0;
    if (calculatorMode === 'lumpsum') {
      principal = monthly;
      future = principal * (1 + annualRate / 100) ** horizon;
    } else {
      for (let month = 0; month < months; month += 1) {
        const currentMonthly = monthly * (1 + annualStepup) ** Math.floor(month / 12);
        future = (future + currentMonthly) * (1 + monthlyRate);
        principal += currentMonthly;
      }
    }
    const inflationAdjusted = future / 1.06 ** horizon;
    investmentLabel.textContent = calculatorMode === 'lumpsum' ? 'One-time investment' : 'Monthly investment';
    investment.min = calculatorMode === 'lumpsum' ? '10000' : '5000';
    investment.max = calculatorMode === 'lumpsum' ? '100000000' : '200000';
    investment.step = calculatorMode === 'lumpsum' ? '10000' : '5000';
    if (sipOnly) sipOnly.hidden = calculatorMode === 'lumpsum' || calculatorMode === 'bond';
    sipTools.forEach((tool) => {
      tool.hidden = calculatorMode === 'bond';
    });
    if (bondPanel) bondPanel.hidden = calculatorMode !== 'bond';
    if (calculatorMode === 'bond') {
      updateBondCalculator();
      return;
    }
    investmentValue.textContent = moneyFull(monthly);
    yearsValue.textContent = `${horizon} years · ${months.toLocaleString('en-IN')} months`;
    rateValue.textContent = `${annualRate}%`;
    stepupValue.textContent = `${annualStepup * 100}%`;
    goalValue.textContent = money(goalAmount);
    futureValue.textContent = money(future);
    principalValue.textContent = money(principal);
    growthValue.textContent = money(future - principal);
    inflationValue.textContent = money(inflationAdjusted);
    goalGap.textContent = future >= goalAmount ? `+ ${money(future - goalAmount)}` : `− ${money(goalAmount - future)}`;
  };
  [investment, years, rate, stepup, goal].forEach((control) => control?.addEventListener('input', updateCalculator));
  [bondAmount, bondTenure, fdRate, bondRate, bondTax].forEach((control) =>
    control?.addEventListener('input', updateBondCalculator)
  );
  document.querySelectorAll<HTMLButtonElement>('[data-calc]').forEach((tab) =>
    tab.addEventListener('click', () => {
      calculatorMode = tab.dataset.calc === 'bond' ? 'bond' : tab.dataset.calc === 'lumpsum' ? 'lumpsum' : 'sip';
      document.querySelectorAll('[data-calc]').forEach((item) => {
        item.classList.toggle('is-active', item === tab);
        item.setAttribute('aria-selected', String(item === tab));
      });
      updateCalculator();
    })
  );
  updateCalculator();
  const menu = document.querySelector('.vf-menu');
  const nav = document.querySelector('.vf-nav');
  menu?.addEventListener('click', () => {
    const open = nav?.classList.toggle('is-open');
    menu.setAttribute('aria-expanded', String(open));
  });
  document.querySelectorAll('.vf-nav a').forEach((link) =>
    link.addEventListener('click', () => {
      nav?.classList.remove('is-open');
      menu?.setAttribute('aria-expanded', 'false');
    })
  );
  document.querySelectorAll<HTMLElement>('[data-solution-card]').forEach((card) => {
    const activateSolution = () => {
      document.querySelectorAll<HTMLElement>('[data-solution-card]').forEach((item) => {
        const active = item === card;
        item.classList.toggle('is-active', active);
        item.setAttribute('aria-expanded', String(active));
      });
    };
    card.addEventListener('click', (event) => {
      if ((event.target as HTMLElement).closest('a')) return;
      activateSolution();
    });
    card.addEventListener('keydown', (event) => {
      if (event.key === 'Enter' || event.key === ' ') {
        event.preventDefault();
        activateSolution();
      }
    });
  });
  const processSteps = [
    [
      '07',
      'Discovery',
      'We listen first.',
      'Your people, priorities, responsibilities and what keeps you awake become part of the brief.',
    ],
    [
      '08',
      'Diagnosis',
      'We make the picture legible.',
      'We review what you own, owe, earn and need — without judgement or jargon.',
    ],
    [
      '09',
      'Design',
      'We build the architecture.',
      'A simple structure connects your goals to an investment approach you can explain to your family.',
    ],
    [
      '10',
      'Implementation',
      'We make the next step doable.',
      'A good plan is only useful when it can be implemented carefully and documented clearly.',
    ],
    [
      '11',
      'Review',
      'We adapt without reacting.',
      'Life and markets change. Reviews are for deliberate decisions, not noise-driven switching.',
    ],
    [
      '12',
      'Communication',
      'We keep the door open.',
      'Questions are welcome between reviews. Clarity is part of the service.',
    ],
  ];
  const processPanel = document.querySelector<HTMLElement>('[data-process-panel]');
  document.querySelectorAll<HTMLButtonElement>('[data-process-tab]').forEach((tab) => {
    const activateProcessTab = () => {
      const step = processSteps.find(([number]) => number === tab.dataset.processTab);
      if (!step || !processPanel) return;
      const [number, title, front, back] = step;
      document.querySelectorAll<HTMLButtonElement>('[data-process-tab]').forEach((item) => {
        const active = item === tab;
        item.classList.toggle('is-active', active);
        item.setAttribute('aria-selected', String(active));
      });
      processPanel.innerHTML = `<span class="vf-card-tag">Step ${number} / ${title}</span><h3>${front}</h3><p>${back}</p><a href="#contact" class="vf-text-link">Discuss this step <span>↗</span></a>`;
      processPanel.setAttribute('aria-labelledby', `process-tab-${number}`);
    };
    tab.addEventListener('click', activateProcessTab);
    tab.addEventListener('keydown', (event) => {
      if (event.key !== 'ArrowRight' && event.key !== 'ArrowLeft') return;
      event.preventDefault();
      const tabs = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-process-tab]'));
      const currentIndex = tabs.indexOf(tab);
      const nextIndex =
        event.key === 'ArrowRight' ? (currentIndex + 1) % tabs.length : (currentIndex - 1 + tabs.length) % tabs.length;
      tabs[nextIndex]?.focus();
      tabs[nextIndex]?.click();
    });
  });
  document.querySelectorAll<HTMLElement>('[data-card-action]').forEach((action) => {
    const goToTarget = () => {
      const target = action.dataset.cardAction;
      if (target) document.querySelector(target)?.scrollIntoView({ behavior: 'smooth', block: 'start' });
    };
    action.addEventListener('click', goToTarget);
    action.addEventListener('keydown', (event) => {
      if (event.key === 'Enter' || event.key === ' ') {
        event.preventDefault();
        goToTarget();
      }
    });
  });
  document.querySelectorAll<HTMLElement>('[data-flip-card]').forEach((card) => {
    const button = card.querySelector<HTMLButtonElement>('.vf-flip-inner');
    button?.addEventListener('click', () => {
      card.classList.remove('is-active');
      void card.offsetWidth;
      card.classList.add('is-active');
      button.setAttribute('aria-pressed', 'true');
      window.setTimeout(() => {
        card.classList.remove('is-active');
        button.setAttribute('aria-pressed', 'false');
      }, 1800);
    });
  });
  const matrixContent = document.querySelector<HTMLElement>('#matrix-content');
  const matrixData: Record<string, { rows: [string, string, string, string][] }> = {
    growth: {
      rows: [
        ['Equity mutual funds', 'Long-term growth', 'Goals 7+ years away', '₹ 5,000 SIP'],
        ['Index funds', 'Core market exposure', 'Simple diversified allocation', '₹ 500 SIP'],
        ['Flexicap funds', 'Active allocation', 'Long-term wealth creation', '₹ 1,000 SIP'],
      ],
    },
    stability: {
      rows: [
        ['Debt mutual funds', 'Income and stability', 'Nearer-term goals', '₹ 5,000 SIP'],
        ['Target maturity funds', 'Defined maturity path', 'Known future liabilities', 'Scheme-specific'],
        ['Bank fixed deposits', 'Capital familiarity', 'Short-term planning', 'Bank terms apply'],
      ],
    },
    protection: {
      rows: [
        ['Emergency reserve', 'Liquidity buffer', 'Unexpected expenses', '3–12 months'],
        ['Term insurance', 'Family protection', 'Income replacement needs', 'Policy-specific'],
        ['Health cover', 'Medical risk transfer', 'Hospitalisation costs', 'Policy-specific'],
      ],
    },
    claims: {
      rows: [
        ['Policy documents', 'Evidence and eligibility', 'Before filing a claim', 'Keep copies'],
        ['Claim intimation', 'Start the process promptly', 'A covered event occurs', 'Insurer timelines'],
        ['Settlement review', 'Check decision and deductions', 'After insurer response', 'Escalation may apply'],
      ],
    },
    credit: {
      rows: [
        ['Credit report', 'Find reporting errors', 'Before applying for credit', 'Obtain from bureau'],
        ['Dispute records', 'Correct inaccurate information', 'A genuine reporting issue', 'Keep evidence'],
        ['Repayment plan', 'Build consistent history', 'Outstanding obligations', 'Lender terms apply'],
      ],
    },
  };
  const renderMatrix = (key: string) => {
    const data = matrixData[key];
    if (!matrixContent || !data) return;
    matrixContent.innerHTML = `<div class="vf-table-head"><span>Instrument</span><span>Role</span><span>Best considered for</span><span>Starting point</span></div>${data.rows.map(([instrument, role, considered, start]) => `<div class="vf-table-row"><strong>${instrument}</strong><span>${role}</span><span>${considered}</span><b>${start}</b></div>`).join('')}`;
  };
  document.querySelectorAll<HTMLButtonElement>('[data-matrix]').forEach((button) =>
    button.addEventListener('click', () => {
      document.querySelectorAll<HTMLButtonElement>('[data-matrix]').forEach((item) => {
        const active = item === button;
        item.classList.toggle('is-active', active);
        item.setAttribute('aria-selected', String(active));
      });
      renderMatrix(button.dataset.matrix ?? 'growth');
    })
  );
  document.querySelectorAll<HTMLButtonElement>('[data-fund]').forEach((button) =>
    button.addEventListener('click', () => {
      document.querySelectorAll('[data-fund]').forEach((item) => item.classList.remove('is-active'));
      button.classList.add('is-active');
      const name = document.querySelector<HTMLElement>('#fund-name');
      const meta = document.querySelector<HTMLElement>('#fund-meta');
      if (!name || !meta) return;
      if (button.dataset.fund === 'two') {
        name.textContent = 'HDFC Balanced Advantage';
        meta.textContent = 'Hybrid · Dynamic Asset Allocation · Direct Growth';
      } else {
        name.textContent = 'Parag Parikh Flexi Cap';
        meta.textContent = 'Equity · Flexicap · Direct Growth';
      }
    })
  );
  const dialog = document.querySelector<HTMLDialogElement>('#portal-dialog');
  document.querySelector('#portal-open')?.addEventListener('click', () => dialog?.showModal());
  document.querySelector('#portal-close')?.addEventListener('click', () => dialog?.close());
  document.querySelector('#consultation-form')?.addEventListener('submit', (event) => {
    event.preventDefault();
    const status = document.querySelector<HTMLElement>('#form-status');
    if (status) {
      status.textContent = 'Thank you. Your enquiry has been noted — our team will be in touch shortly.';
      status.style.color = '#356b5f';
    }
  });
</script>
