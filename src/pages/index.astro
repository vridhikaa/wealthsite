<script>
  const money = (value: number) => {
    const crore = value / 10000000;
    const lakh = value / 100000;
    if (crore >= 1) return `₹ ${crore.toFixed(crore >= 10 ? 1 : 2)} Cr`;
    if (lakh >= 1) return `₹ ${lakh.toFixed(lakh >= 10 ? 1 : 2)} Lakh`;
    return `₹ ${Math.round(value).toLocaleString('en-IN')}`;
  };
  const moneyFull = (value: number) => `₹ ${Math.round(value).toLocaleString('en-IN')}`;
  const investment = document.querySelector<HTMLInputElement>('#investment');
  const investmentLabel = document.querySelector<HTMLElement>('#investment-label');
  const sipOnly = document.querySelector<HTMLElement>('[data-sip-only]');
  const years = document.querySelector<HTMLInputElement>('#years');
  const rate = document.querySelector<HTMLInputElement>('#rate');
  const stepup = document.querySelector<HTMLInputElement>('#stepup');
  const goal = document.querySelector<HTMLInputElement>('#goal');
  const stepupValue = document.querySelector<HTMLOutputElement>('#stepup-value');
  const goalValue = document.querySelector<HTMLOutputElement>('#goal-value');
  const inflationValue = document.querySelector<HTMLOutputElement>('#inflation-value');
  const goalGap = document.querySelector<HTMLOutputElement>('#goal-gap');
  const investmentValue = document.querySelector<HTMLOutputElement>('#investment-value');
  const yearsValue = document.querySelector<HTMLOutputElement>('#years-value');
  const rateValue = document.querySelector<HTMLOutputElement>('#rate-value');
  const futureValue = document.querySelector<HTMLOutputElement>('#future-value');
  const principalValue = document.querySelector<HTMLOutputElement>('#principal-value');
  const growthValue = document.querySelector<HTMLOutputElement>('#growth-value');
  let calculatorMode: 'sip' | 'lumpsum' = 'sip';
  const updateCalculator = () => {
    if (
      !investment ||
      !investmentLabel ||
      !years ||
      !rate ||
      !investmentValue ||
      !yearsValue ||
      !rateValue ||
      !futureValue ||
      !principalValue ||
      !growthValue ||
      !stepup ||
      !goal ||
      !stepupValue ||
      !goalValue ||
      !inflationValue ||
      !goalGap
    )
      return;
    const monthly = Number(investment.value);
    const horizon = Number(years.value);
    const annualRate = Number(rate.value);
    const annualStepup = Number(stepup.value) / 100;
    const goalAmount = Number(goal.value);
    const monthlyRate = annualRate / 100 / 12;
    const months = horizon * 12;
    let future = 0;
    let principal = 0;
    if (calculatorMode === 'lumpsum') {
      principal = monthly;
      future = principal * (1 + annualRate / 100) ** horizon;
    } else {
      for (let month = 0; month < months; month += 1) {
        const currentMonthly = monthly * (1 + annualStepup) ** Math.floor(month / 12);
        future = (future + currentMonthly) * (1 + monthlyRate);
        principal += currentMonthly;
      }
    }
    const inflationAdjusted = future / 1.06 ** horizon;
    investmentLabel.textContent = calculatorMode === 'lumpsum' ? 'One-time investment' : 'Monthly investment';
    investment.min = calculatorMode === 'lumpsum' ? '10000' : '5000';
    investment.max = calculatorMode === 'lumpsum' ? '100000000' : '200000';
    investment.step = calculatorMode === 'lumpsum' ? '10000' : '5000';
    if (sipOnly) sipOnly.hidden = calculatorMode === 'lumpsum';
    investmentValue.textContent = moneyFull(monthly);
    yearsValue.textContent = `${horizon} years · ${months.toLocaleString('en-IN')} months`;
    rateValue.textContent = `${annualRate}%`;
    stepupValue.textContent = `${annualStepup * 100}%`;
    goalValue.textContent = money(goalAmount);
    futureValue.textContent = money(future);
    principalValue.textContent = money(principal);
    growthValue.textContent = money(future - principal);
    inflationValue.textContent = money(inflationAdjusted);
    goalGap.textContent = future >= goalAmount ? `+ ${money(future - goalAmount)}` : `− ${money(goalAmount - future)}`;
  };
  [investment, years, rate, stepup, goal].forEach((control) => control?.addEventListener('input', updateCalculator));
  document.querySelectorAll<HTMLButtonElement>('[data-calc]').forEach((tab) =>
    tab.addEventListener('click', () => {
      calculatorMode = tab.dataset.calc === 'lumpsum' ? 'lumpsum' : 'sip';
      document.querySelectorAll('[data-calc]').forEach((item) => {
        item.classList.toggle('is-active', item === tab);
        item.setAttribute('aria-selected', String(item === tab));
      });
      updateCalculator();
    })
  );
  updateCalculator();
  const menu = document.querySelector('.vf-menu');
  const nav = document.querySelector('.vf-nav');
  menu?.addEventListener('click', () => {
    const open = nav?.classList.toggle('is-open');
    menu.setAttribute('aria-expanded', String(open));
  });
  document.querySelectorAll('.vf-nav a').forEach((link) =>
    link.addEventListener('click', () => {
      nav?.classList.remove('is-open');
      menu?.setAttribute('aria-expanded', 'false');
    })
  );
  document.querySelectorAll<HTMLElement>('[data-card-action]').forEach((action) => {
    const goToTarget = () => {
      const target = action.dataset.cardAction;
      if (target) document.querySelector(target)?.scrollIntoView({ behavior: 'smooth', block: 'start' });
    };
    action.addEventListener('click', goToTarget);
    action.addEventListener('keydown', (event) => {
      if (event.key === 'Enter' || event.key === ' ') {
        event.preventDefault();
        goToTarget();
      }
    });
  });
  document.querySelectorAll<HTMLElement>('[data-flip-card]').forEach((card) => {
    const button = card.querySelector<HTMLButtonElement>('.vf-flip-inner');
    button?.addEventListener('click', () => {
      card.classList.remove('is-active');
      void card.offsetWidth;
      card.classList.add('is-active');
      button.setAttribute('aria-pressed', 'true');
      window.setTimeout(() => {
        card.classList.remove('is-active');
        button.setAttribute('aria-pressed', 'false');
      }, 1800);
    });
  });
  document.querySelectorAll('[data-matrix]').forEach((button) =>
    button.addEventListener('click', () => {
      document.querySelectorAll('[data-matrix]').forEach((item) => item.classList.remove('is-active'));
      button.classList.add('is-active');
    })
  );
  document.querySelectorAll<HTMLButtonElement>('[data-fund]').forEach((button) =>
    button.addEventListener('click', () => {
      document.querySelectorAll('[data-fund]').forEach((item) => item.classList.remove('is-active'));
      button.classList.add('is-active');
      const name = document.querySelector<HTMLElement>('#fund-name');
      const meta = document.querySelector<HTMLElement>('#fund-meta');
      if (!name || !meta) return;
      if (button.dataset.fund === 'two') {
        name.textContent = 'HDFC Balanced Advantage';
        meta.textContent = 'Hybrid · Dynamic Asset Allocation · Direct Growth';
      } else {
        name.textContent = 'Parag Parikh Flexi Cap';
        meta.textContent = 'Equity · Flexicap · Direct Growth';
      }
    })
  );
  const dialog = document.querySelector<HTMLDialogElement>('#portal-dialog');
  document.querySelector('#portal-open')?.addEventListener('click', () => dialog?.showModal());
  document.querySelector('#portal-close')?.addEventListener('click', () => dialog?.close());
  document.querySelector('#consultation-form')?.addEventListener('submit', (event) => {
    event.preventDefault();
    const status = document.querySelector<HTMLElement>('#form-status');
    if (status) {
      status.textContent = 'Thank you. Your enquiry has been noted — our team will be in touch shortly.';
      status.style.color = '#356b5f';
    }
  });
</script>
