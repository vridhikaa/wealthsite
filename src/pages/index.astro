      top: 76px;
    }
    .vf-hero {
      padding-top: 3rem;
      padding-bottom: 3rem;
    }
    .vf-hero-copy h1 {
      font-size: clamp(3rem, 15vw, 4rem);
      line-height: 0.95;
    }
    .vf-hero-art {
      min-height: 270px;
    }
    .vf-art-ring {
      width: 190px;
      height: 190px;
    }
    .vf-trustbar {
      grid-template-columns: 1fr;
      gap: 1.1rem;
