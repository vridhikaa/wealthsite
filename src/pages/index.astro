---
import Layout from '~/layouts/PageLayout.astro';

const logoUrl = 'https://hebbkx1anhila5yf.public.blob.vercel-storage.com/logo-8O1fGPXeCwjl97D7yMhlbMRCwMM2wz.png';

const metadata = {
  title: 'Wealth Management & Investment Consult in India | Vridhikaa Finserv',
  description:
    'Human, research-led wealth management in India across mutual funds, bonds, insurance, index funds and alternatives. Build a clearer long-term investment plan with Vridhikaa Finserv.',
  canonical: 'https://vridhikaafinserv.com/',
  openGraph: {
    type: 'website',
    url: 'https://vridhikaafinserv.com/',
    siteName: 'Vridhikaa Finserv',
    images: [{ url: logoUrl, width: 1200, height: 628 }],
  },
  ignoreTitleTemplate: true,
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    {
      '@type': 'Question',
      name: 'What does a wealth manager do?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'A wealth manager helps connect your goals, cash flow, investments, protection and tax context into a plan you can review over time.',
      },
    },
    {
      '@type': 'Question',
      name: 'Are mutual fund returns guaranteed?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'No. Mutual fund investments are market-linked. Risk, time horizon, costs and the scheme Riskometer should be considered before investing.',
      },
    },
  ],
};
---

<Layout metadata={metadata}>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  <main class="vf-shell">
    <div class="vf-topline">
      <span>Independent wealth consult</span><span>SEBI | AMFI | IRDAI aligned practice</span>
    </div>
    <header class="vf-header" id="site-header">
      <a class="vf-brand" href="#top" aria-label="Vridhikaa Finserv home"
        ><img src={logoUrl} alt="Vridhikaa Finserv" /></a
      >
      <nav class="vf-nav" id="primary-nav" aria-label="Primary navigation">
        <a href="#approach">Our approach</a>
        <a href="#solutions">Solutions</a>
        <a href="#tools">Investor tools</a>
        <a href="#insights">Insights</a>
      </nav>
      <div class="vf-header-actions">
        <a class="vf-text-link hide-mobile" href="#contact">Get in touch <span>↗</span></a><button
          class="vf-menu"
          type="button"
          aria-expanded="false"
          aria-controls="primary-nav">Menu <span>＋</span></button
        >
      </div>
    </header>

    <section class="vf-hero" id="top">
      <div class="vf-hero-copy">
        <h1>Make your money<br /><em>mean more.</em></h1>
        <p class="vf-lead">
          Thoughtful advice for the capital you have built — and the life, legacy and freedom it is meant to support.
        </p>
        <div class="vf-hero-actions">
          <a class="vf-button vf-button-dark" href="#contact">Begin a conversation <span>↗</span></a><a
            class="vf-text-link"
            href="#approach">Discover our approach <span>↓</span></a
          >
        </div>
      </div>
      <div class="vf-hero-art" aria-label="Vridhikaa Finserv signature mark">
        <div class="vf-art-glow"></div><div class="vf-art-ring"></div><img
          class="vf-hero-logo"
          src={logoUrl}
          alt="Vridhikaa Finserv upward arrow and lotus emblem"
        /><div class="vf-art-caption">
          <strong>Vridhi-Riddhi-Wealth</strong><span>Live Sorted · India</span>
        </div>
      </div>
    </section>

    <section class="vf-trustbar">
      <div><strong>₹ 2,500 Cr+</strong><span>Assets guided</span></div><div>
        <strong>1,200+</strong><span>Families & institutions</span>
      </div><div><strong>11 years</strong><span>Of considered advice</span></div><p>
        Built on trust.<br />Measured in time.
      </p>
    </section>

    <section class="vf-decision-desk" aria-label="Choose your next step">
      <div class="vf-desk-intro">
        <p class="vf-kicker">Your next useful step</p>
        <h2>Start where the<br /><em>question is.</em></h2>
      </div>
      <div class="vf-desk-grid">
        <a href="#tools" class="vf-desk-card"
          ><span class="vf-desk-index">01</span><strong>What could I invest?</strong><small
            >Use the SIP and lumpsum planner</small
          ><span class="vf-desk-arrow" aria-hidden="true">↗</span></a
        >
        <a href="#instruments" class="vf-desk-card"
          ><span class="vf-desk-index">02</span><strong>What should I understand?</strong><small
            >Compare instruments in plain English</small
          ><span class="vf-desk-arrow" aria-hidden="true">↗</span></a
        >
        <a href="#approach" class="vf-desk-card"
          ><span class="vf-desk-index">03</span><strong>How should I begin?</strong><small
            >See the Vridhikaa process</small
          ><span class="vf-desk-arrow" aria-hidden="true">↗</span></a
        >
        <a href="#contact" class="vf-desk-card vf-desk-card-dark"
          ><span class="vf-desk-index">04</span><strong>Can we talk it through?</strong><small
            >Begin a considered conversation</small
          ><span class="vf-desk-arrow" aria-hidden="true">↗</span></a
        >
      </div>
    </section>

    <section class="vf-section vf-approach" id="approach">
      <div class="vf-section-intro">
        <p class="vf-kicker">The Vridhikaa standard</p><h2>Less noise.<br /><em>More conviction.</em></h2>
      </div><div class="vf-approach-body">
        <p class="vf-big-copy">
          We start with the real life behind the numbers: a child’s education, a business sale, parents to support, or
          the quiet wish to work on your own terms. Then we shape the money around that life — not the other way around.
        </p><div class="vf-principles">
          <article>
            <span>01</span><h3>Listen deeply</h3><p>
              Your goals, your context, your definition of enough. Every plan starts with the questions that matter.
            </p>
          </article><article>
            <span>02</span><h3>Build deliberately</h3><p>
              Evidence-led portfolios across asset classes, designed around your horizon — not the headlines.
            </p>
          </article><article>
            <span>03</span><h3>Stay accountable</h3><p>
              Clear communication, disciplined reviews and no product-first incentives. Just advice you can trust.
            </p>
          </article>
        </div>
      </div>
    </section>

    <section class="vf-section vf-solutions" id="solutions">
      <div class="vf-section-heading">
        <div><p class="vf-kicker">Our solutions</p><h2>A wider lens<br /><em>on wealth.</em></h2></div><p>
          One partner across the moving parts of your financial life — with the depth to go specialist when it counts.
        </p>
      </div><div class="vf-service-grid">
        <article class="vf-service vf-service-featured">
          <span class="vf-service-no">01 / CORE</span><h3>Mutual funds<br /><em>& portfolio design</em></h3><p>
            Goal-led allocation across equity, debt and hybrid strategies. Curated with patience, monitored with
            discipline.
          </p><a href="#contact">Explore portfolios <span>↗</span></a>
        </article><article class="vf-service">
          <span class="vf-service-no">02 / STABILITY</span><h3>Fixed income<br /><em>& bonds</em></h3><p>
            Tax-aware income solutions, from government securities and target maturity funds to carefully selected
            corporate bonds.
          </p><a href="#tools">See the universe <span>↗</span></a>
        </article><article class="vf-service">
          <span class="vf-service-no">03 / PROTECTION</span><h3>Insurance<br /><em>& risk cover</em></h3><p>
            Protection designed around people, liabilities and the life you want to keep building.
          </p><a href="#contact">Protect what matters <span>↗</span></a>
        </article><article class="vf-service">
          <span class="vf-service-no">04 / ALTERNATIVES</span><h3>PMS, AIF<br /><em>& structured notes</em></h3><p>
            Access to differentiated ideas for eligible investors, with suitability and risk at the centre.
          </p><a href="#contact">Explore alternatives <span>↗</span></a>
        </article>
      </div>
    </section>

    <section class="vf-section vf-instruments" id="instruments">
      <div class="vf-section-heading">
        <div>
          <p class="vf-kicker">Financial instruments, explained</p><h2>Know what your<br /><em>money is doing.</em></h2>
        </div>
        <p>
          Flip a card for the human version: where an instrument can help, what can go wrong, and which official source
          to read next.
        </p>
      </div>
      <div class="vf-instrument-grid">
        <article class="vf-flip-card" data-flip-card>
          <button class="vf-flip-inner" type="button" aria-pressed="false" aria-label="Show equity mutual fund details">
            <span class="vf-flip-face vf-flip-front"
              ><span class="vf-card-icon vf-icon-chart" aria-hidden="true"
                ><svg viewBox="0 0 48 48" fill="none"
                  ><path
                    d="M8 36 19 25l7 6 14-17"
                    stroke="currentColor"
                    stroke-width="3"
                    stroke-linecap="round"
                    stroke-linejoin="round"></path><path
                    d="M31 14h9v9"
                    stroke="currentColor"
                    stroke-width="3"
                    stroke-linecap="round"
                    stroke-linejoin="round"></path></svg
                ></span
              ><span class="vf-card-tag">01 / Growth</span><strong>Equity<br /><em>mutual funds</em></strong><p
                class="vf-card-summary"
              >
                Diversified market participation for long-term goals, managed within a defined risk profile.
              </p><span class="vf-card-meter"><i style="width:82%"></i></span><small>Horizon: usually 7+ years</small
              ></span
            >
            <span class="vf-flip-face vf-flip-back"
              ><span class="vf-card-tag">Plain English</span><strong>For goals that can wait.</strong><p>
                Your money is pooled and invested in shares. It can move sharply in the short term, but diversification
                and time can make it useful for long-term goals.
              </p><small
                >Riskometer applies · Read <a
                  href="https://www.sebi.gov.in/legal/circulars/oct-2020/standardized-risk-o-meter-for-mutual-fund-schemes_47864.html"
                  target="_blank"
                  rel="noreferrer">SEBI’s riskometer guidance</a
                >.</small
              ></span
            >
          </button>
        </article>
        <article class="vf-flip-card" data-flip-card>
          <button
            class="vf-flip-inner"
            type="button"
            aria-pressed="false"
            aria-label="Show bonds and fixed income details"
          >
            <span class="vf-flip-face vf-flip-front"
              ><span class="vf-card-icon vf-icon-bond" aria-hidden="true"
                ><svg viewBox="0 0 48 48" fill="none"
                  ><path d="M8 14h32M8 24h32M8 34h32" stroke="currentColor" stroke-width="3" stroke-linecap="round"
                  ></path><path d="M14 8v32M24 8v32M34 8v32" stroke="currentColor" stroke-width="1.5" opacity=".65"
                  ></path></svg
                ></span
              ><span class="vf-card-tag">02 / Stability</span><strong>Bonds &<br /><em>fixed income</em></strong><p
                class="vf-card-summary"
              >
                Income-oriented instruments designed to bring stability, liquidity and balance to a portfolio.
              </p><span class="vf-card-meter"><i style="width:54%"></i></span><small>Role: income and ballast</small
              ></span
            >
            <span class="vf-flip-face vf-flip-back"
              ><span class="vf-card-tag">Plain English</span><strong>For the part that steadies you.</strong><p>
                A bond is a loan to a government or company. You receive interest, but credit, interest-rate and
                liquidity risks still matter.
              </p><small
                >Compare sovereign options with <a
                  href="https://www.rbi.org.in/Scripts/FAQView.aspx?Id=79"
                  target="_blank"
                  rel="noreferrer">RBI’s government securities guide</a
                >.</small
              ></span
            >
          </button>
        </article>
        <article class="vf-flip-card" data-flip-card>
          <button class="vf-flip-inner" type="button" aria-pressed="false" aria-label="Show index fund details">
            <span class="vf-flip-face vf-flip-front"
              ><span class="vf-card-icon vf-icon-grid" aria-hidden="true"
                ><svg viewBox="0 0 48 48" fill="none"
                  ><rect x="8" y="8" width="12" height="12" rx="2" stroke="currentColor" stroke-width="3"></rect><rect
                    x="28"
                    y="8"
                    width="12"
                    height="12"
                    rx="2"
                    stroke="currentColor"
                    stroke-width="3"></rect><rect
                    x="8"
                    y="28"
                    width="12"
                    height="12"
                    rx="2"
                    stroke="currentColor"
                    stroke-width="3"></rect><rect
                    x="28"
                    y="28"
                    width="12"
                    height="12"
                    rx="2"
                    stroke="currentColor"
                    stroke-width="3"></rect></svg
                ></span
              ><span class="vf-card-tag">03 / Core</span><strong>Index<br /><em>funds</em></strong><p
                class="vf-card-summary"
              >
                A simple, diversified way to follow a market index with transparent portfolio exposure.
              </p><span class="vf-card-meter"><i style="width:68%"></i></span><small>Role: broad market exposure</small
              ></span
            >
            <span class="vf-flip-face vf-flip-back"
              ><span class="vf-card-tag">Plain English</span><strong>For keeping it simple.</strong><p>
                An index fund follows a market index instead of trying to pick every winner. Costs and tracking
                difference are worth checking before investing.
              </p><small
                >Mutual fund education: <a
                  href="https://www.amfiindia.com/investor-corner/knowledge-center"
                  target="_blank"
                  rel="noreferrer">AMFI Knowledge Centre</a
                >.</small
              ></span
            >
          </button>
        </article>
        <article class="vf-flip-card" data-flip-card>
          <button class="vf-flip-inner" type="button" aria-pressed="false" aria-label="Show insurance details">
            <span class="vf-flip-face vf-flip-front"
              ><span class="vf-card-icon vf-icon-shield" aria-hidden="true"
                ><svg viewBox="0 0 48 48" fill="none"
                  ><path
                    d="M24 6 39 12v11c0 10-6.5 16-15 20-8.5-4-15-10-15-20V12l15-6Z"
                    stroke="currentColor"
                    stroke-width="3"
                    stroke-linejoin="round"></path><path
                    d="m17 24 5 5 10-11"
                    stroke="currentColor"
                    stroke-width="3"
                    stroke-linecap="round"
                    stroke-linejoin="round"></path></svg
                ></span
              ><span class="vf-card-tag">04 / Protection</span><strong>Insurance<br /><em>cover</em></strong><p
                class="vf-card-summary"
              >
                Protection for health, income and family responsibilities that investments cannot replace.
              </p><span class="vf-card-meter"><i style="width:38%"></i></span><small>Role: protect earning power</small
              ></span
            >
            <span class="vf-flip-face vf-flip-back"
              ><span class="vf-card-tag">Plain English</span><strong>For the risks investments cannot fix.</strong><p>
                Life and health cover protect people, not portfolios. Start with the financial gap your family would
                face, then check exclusions and claim terms.
              </p><small
                >Product oversight: <a href="https://irdai.gov.in/consumer-education" target="_blank" rel="noreferrer"
                  >IRDAI consumer education</a
                >.</small
              ></span
            >
          </button>
        </article>
        <article class="vf-flip-card" data-flip-card>
          <button class="vf-flip-inner" type="button" aria-pressed="false" aria-label="Show PMS and AIF details">
            <span class="vf-flip-face vf-flip-front"
              ><span class="vf-card-icon vf-icon-dots" aria-hidden="true"
                ><svg viewBox="0 0 48 48" fill="none"
                  ><circle cx="12" cy="24" r="4" fill="currentColor"></circle><circle
                    cx="24"
                    cy="24"
                    r="4"
                    fill="currentColor"></circle><circle cx="36" cy="24" r="4" fill="currentColor"></circle><path
                    d="M12 24 24 12l12 12-12 12-12-12Z"
                    stroke="currentColor"
                    stroke-width="1.5"
                    opacity=".55"></path></svg
                ></span
              ><span class="vf-card-tag">05 / Alternatives</span><strong>PMS &<br /><em>AIFs</em></strong><p
                class="vf-card-summary"
              >
                Specialist strategies for eligible investors seeking differentiated exposure and a deeper suitability
                review.
              </p><span class="vf-card-meter"><i style="width:91%"></i></span><small
                >Suitability: eligible investors</small
              ></span
            >
            <span class="vf-flip-face vf-flip-back"
              ><span class="vf-card-tag">Plain English</span><strong>For a portfolio with a bigger toolkit.</strong><p>
                These structures may offer concentrated or private-market exposure. Fees, lock-ins, valuation risk and
                access rules need a careful suitability check.
              </p><small
                >Start with <a
                  href="https://www.sebi.gov.in/curation/alternative-investment-funds.html"
                  target="_blank"
                  rel="noreferrer">SEBI’s AIF information</a
                >.</small
              ></span
            >
          </button>
        </article>
      </div>
      <p class="vf-source-note">
        Data note: the card content describes product characteristics, not expected returns. Mutual fund assets in India
        stood at ₹82.03 lakh crore as of 28 February 2026, according to AMFI. Figures are informational and should be
        checked against current official disclosures.
      </p>
    </section>

    <section class="vf-section vf-practice" id="what-we-do">
      <div class="vf-section-heading">
        <div><p class="vf-kicker">What we do</p><h2>Advice with a<br /><em>human centre.</em></h2></div><p>
          Tap any card to see how we make a complex money decision feel more considered, practical and yours.
        </p>
      </div>
      <div class="vf-practice-grid">
        {
          [
            [
              '01',
              'Goal planning',
              'Turn life milestones into a clear, prioritised money map.',
              'A plan starts with what you want your money to make possible — not with a product list.',
            ],
            [
              '02',
              'Cash-flow mapping',
              'See what can be invested without making today feel tight.',
              'We separate essentials, optional spending, reserves and investable surplus so the plan can breathe.',
            ],
            [
              '03',
              'Retirement design',
              'Build income visibility for the years when work becomes optional.',
              'We model contributions, time, inflation and withdrawal needs together, then keep the assumptions visible.',
            ],
            [
              '04',
              'Succession planning',
              'Prepare wealth to move clearly and thoughtfully across generations.',
              'Nomination, documentation, family conversations and ownership deserve the same care as allocation.',
            ],
            [
              '05',
              'Tax-aware structuring',
              'Make tax a consideration, never the whole investment thesis.',
              'We flag where tax treatment may change the outcome and ask you to confirm details with your tax adviser.',
            ],
            [
              '06',
              'Family governance',
              'Create a shared language for money across a family.',
              'Different generations can have different goals. A calm process helps everyone understand the why.',
            ],
          ].map(([number, title, front, back]) => (
            <article class="vf-flip-card vf-practice-card" data-flip-card>
              <button
                class="vf-flip-inner"
                type="button"
                aria-pressed="false"
                aria-label={`Show details about ${title}`}
              >
                <>
                  <span class="vf-flip-face vf-flip-front">
                    <>
                      <span class="vf-card-tag">{number} / What we do</span>
                      <strong>{title}</strong>
                      <p>{front}</p>
                      <span class="vf-card-action" data-card-action="#contact" role="link" tabindex="0">
                        Discuss this approach <span aria-hidden="true">↗</span>
                      </span>
                    </>
                  </span>
                  <span class="vf-flip-face vf-flip-back">
                    <>
                      <span class="vf-card-tag">Our perspective</span>
                      <strong>{title}</strong>
                      <p>{back}</p>
                      <span class="vf-card-hint">Tap to return ↺</span>
                    </>
                  </span>
                </>
              </button>
            </article>
          ))
        }
      </div>
    </section>

    <section class="vf-section vf-process" id="how-we-do">
      <div class="vf-section-heading">
        <div><p class="vf-kicker">How we do it</p><h2>A process that<br /><em>stays with you.</em></h2></div><p>
          No black boxes. Each step has a reason, a conversation and a next action you can understand.
        </p>
      </div>
      <div class="vf-practice-grid">
        {
          [
            [
              '07',
              'Discovery',
              'We listen first.',
              'Your people, priorities, responsibilities and what keeps you awake become part of the brief.',
            ],
            [
              '08',
              'Diagnosis',
              'We make the picture legible.',
              'We review what you own, owe, earn and need — without judgement or jargon.',
            ],
            [
              '09',
              'Allocation',
              'We give every rupee a role.',
              'Growth, stability, protection and liquidity are balanced around your time horizon.',
            ],
            [
              '10',
              'Implementation',
              'We make the next step doable.',
              'A good plan is only useful when it can be implemented carefully and documented clearly.',
            ],
            [
              '11',
              'Review',
              'We adapt without reacting.',
              'Life and markets change. Reviews are for deliberate decisions, not noise-driven switching.',
            ],
            [
              '12',
              'Communication',
              'We keep the door open.',
              'You receive plain-language updates, useful context and a place to ask the question behind the question.',
            ],
          ].map(([number, title, front, back]) => (
            <article class="vf-flip-card vf-practice-card" data-flip-card>
              <button
                class="vf-flip-inner"
                type="button"
                aria-pressed="false"
                aria-label={`Show details about ${title}`}
              >
                <>
                  <span class="vf-flip-face vf-flip-front">
                    <>
                      <span class="vf-card-tag">{number} / How we do it</span>
                      <strong>{title}</strong>
                      <p>{front}</p>
                      <span class="vf-card-action" data-card-action="#contact" role="link" tabindex="0">
                        Discuss this approach <span aria-hidden="true">↗</span>
                      </span>
                    </>
                  </span>
                  <span class="vf-flip-face vf-flip-back">
                    <>
                      <span class="vf-card-tag">The Vridhikaa way</span>
                      <strong>{title}</strong>
                      <p>{back}</p>
                      <span class="vf-card-hint">Tap to return ↺</span>
                    </>
                  </span>
                </>
              </button>
            </article>
          ))
        }
      </div>
    </section>

    <section class="vf-section vf-tools" id="tools">
      <div class="vf-section-heading">
        <div><p class="vf-kicker">Investor tools</p><h2>Numbers become<br /><em>useful here.</em></h2></div><p>
          Start with a simple view. Then let a conversation add the nuance no calculator can.
        </p>
      </div><div class="vf-tool-layout">
        <div class="vf-calculator">
          <div class="vf-tool-tabs" role="tablist">
            <button class="is-active" data-calc="sip" role="tab">Monthly SIP</button><button
              data-calc="lumpsum"
              role="tab">Lumpsum</button
            >
          </div><div class="vf-calc-row">
            <label
              ><span id="investment-label">Monthly investment</span>
              <output id="investment-value">₹ 25,000</output><input
                id="investment"
                type="range"
                min="5000"
                max="200000"
                step="5000"
                value="25000"
              /></label
            ><label
              >Time horizon <output id="years-value">10 years</output><input
                id="years"
                type="range"
                min="1"
                max="30"
                step="1"
                value="10"
              /></label
            ><label
              >Illustrative return <output id="rate-value">12%</output><input
                id="rate"
                type="range"
                min="6"
                max="18"
                step="1"
                value="12"
              /></label
            >
          </div><div class="vf-calc-extra" data-sip-only>
            <label
              >Annual SIP step-up <output id="stepup-value">10%</output><input
                id="stepup"
                type="range"
                min="0"
                max="20"
                step="1"
                value="10"
              /></label
            ><label
              >Target goal <output id="goal-value">₹ 75 L</output><input
                id="goal"
                type="range"
                min="1000000"
                max="50000000"
                step="500000"
                value="7500000"
              /></label
            >
          </div><div class="vf-calc-result">
            <div><span>Estimated value*</span><strong id="future-value">₹ 58.1 L</strong></div><div>
              <span>Your investment</span><strong id="principal-value">₹ 30.0 L</strong>
